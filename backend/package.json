{
  "name": "agetic-nestjs-base-backend",
  "version": "1.0",
  "description": "Backend base con Nest.js, TypeORM y TypeScript",
  "author": "crismch",
  "private": true,
  "license": "LP-Bolivia",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "set NODE_ENV=development&& nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "set NODE_ENV=production&& node dist/src/main",
    "start:qas": "set NODE_ENV=development&& node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@golevelup/ts-jest": "0.5.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "3.0.2",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "10.3.8",
    "@nestjs/config": "3.2.2",
    "@nestjs/core": "10.3.8",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.3.8",
    "@nestjs/schedule": "4.0.2",
    "@nestjs/swagger": "7.3.1",
    "@nestjs/typeorm": "10.0.2",
    "@types/express-list-endpoints": "6.0.3",
    "@types/html-to-pdfmake": "2.4.4",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cls-rtracer": "2.6.3",
    "connect-typeorm": "2.0.0",
    "cookie-parser": "1.4.6",
    "csurf": "1.11.0",
    "dayjs": "1.11.10",
    "dotenv": "16.4.5",
    "ejs": "3.1.10",
    "express-list-endpoints": "7.1.0",
    "express-session": "1.18.0",
    "fast-redact": "3.5.0",
    "file-stream-rotator": "1.0.0",
    "flatted": "3.3.1",
    "helmet": "7.1.0",
    "html-to-pdfmake": "2.5.7",
    "husky": "9.0.11",
    "ip": "2.0.1",
    "jsdom": "24.0.0",
    "nanoid": "3.3.7",
    "nest-authz": "2.8.0",
    "openid-client": "5.6.5",
    "pako": "2.1.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "pdfmake": "0.2.10",
    "pg": "8.11.5",
    "pino": "8.20.0",
    "pino-loki": "2.2.1",
    "rxjs": "7.8.1",
    "sql-formatter": "15.3.0",
    "swagger-ui-express": "5.0.0",
    "typeorm": "0.3.20",
    "typeorm-adapter": "1.7.0",
    "uuid": "9.0.1",
    "zxcvbn-typescript": "5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.2.2",
    "@commitlint/config-conventional": "19.2.2",
    "@compodoc/compodoc": "1.1.23",
    "@nestjs/cli": "10.3.2",
    "@nestjs/schematics": "10.1.1",
    "@nestjs/testing": "10.3.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "1.4.7",
    "@types/cron": "2.0.1",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.0",
    "@types/fast-redact": "3.0.4",
    "@types/ip": "1.1.3",
    "@types/jest": "29.5.12",
    "@types/multer": "^1.4.12",
    "@types/node": "20.12.7",
    "@types/pako": "2.0.3",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/pdfmake": "0.2.9",
    "@types/supertest": "6.0.2",
    "@types/uuid": "9.0.8",
    "@types/zxcvbn": "4.4.4",
    "@typescript-eslint/eslint-plugin": "7.7.0",
    "@typescript-eslint/parser": "7.7.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "jest": "29.7.0",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.2.5",
    "standard-version": "9.5.0",
    "supertest": "6.3.4",
    "ts-jest": "29.1.2",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "src/main.ts",
      "src/database/migrations/",
      "src/database/seeds/",
      ".module.ts",
      ".entity.ts",
      ".dto.ts",
      ".guard.ts",
      ".enum.ts"
    ],
    "collectCoverage": true,
    "testResultsProcessor": "jest-sonar-reporter",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/../src/$1"
    }
  },
  "engines": {
    "node": "^20",
    "npm": ">=10"
  }
}
